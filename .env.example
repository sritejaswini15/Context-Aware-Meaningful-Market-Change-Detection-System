# Copy to backend/.env for local runs without Docker. Never commit real values.

# --- Core ---------------------------------------------------------------
APP_ENV=development
DATABASE_URL=postgresql+psycopg://knoww:knoww@localhost:5432/knoww
# Optional. Without Redis, Knoww falls back to in-process caching/rate limits/locks.
REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=http://localhost:3000

# --- Authentication -------------------------------------------------------
# local: Knoww issues its own JWT (development). cognito: Amazon Cognito (production).
AUTH_MODE=local
JWT_SECRET=change-me-to-a-long-random-string
COGNITO_REGION=
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COOKIE_SECURE=false

# --- Market data ----------------------------------------------------------
# Provider chain in priority order: mock, mock-reference, finnhub
MARKET_PROVIDERS=mock,mock-reference
FINNHUB_API_KEY=
CONFLICT_TOLERANCE_PCT=1.0
MARKET_REFRESH_SECONDS=60
DEMO_MODE=true

# --- AI explanation layer (optional) --------------------------------------
# anthropic | none. Without a key Knoww uses deterministic explanations.
AI_PROVIDER=none
AI_API_KEY=
AI_MODEL=

# --- Async processing -----------------------------------------------------
# inline: jobs run in-process (no AWS needed). sqs: Amazon SQS / ElasticMQ.
QUEUE_BACKEND=inline
SQS_QUEUE_URL=
AWS_REGION=ap-south-1
AWS_ENDPOINT_URL=
# local: built-in scheduler. eventbridge: schedules come from EventBridge Scheduler.
SCHEDULER_MODE=local

# --- Observability --------------------------------------------------------
LOG_LEVEL=INFO
LOG_JSON=true
SENTRY_DSN=
